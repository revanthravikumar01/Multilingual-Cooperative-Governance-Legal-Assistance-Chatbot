# Comma-separated browser origins allowed during local development.
# Native Flutter apps do not use browser CORS, but this supports Flutter web.
CIVI_ALLOWED_ORIGINS=*

# Session memory expires after this many minutes without activity (Decision 31).
CIVI_SESSION_TTL_MINUTES=30
# Most recent messages kept per session.
CIVI_MAX_SESSION_MESSAGES=40

# ---------- Knowledge base (Phase 2) ----------
# Embedding model: free, runs on this laptop, downloads once (~2.3 GB). Same model for documents and questions.
# Chosen by evaluation (2026-11-25): finds the right section for Tamil questions without translation.
# After changing it, run: python -m app.scripts.kb rebuild
CIVI_EMBEDDING_MODEL=BAAI/bge-m3
CIVI_MAX_UPLOAD_MB=50
CIVI_CHUNK_MAX_CHARS=1200
CIVI_CHUNK_OVERLAP_CHARS=200
# Minimum similarity (0-1) for evidence to count. Tuned for bge-m3 with python -m app.scripts.evaluate --sweep
CIVI_RELEVANCE_THRESHOLD=0.52
# Threshold for Tamil text searched directly (same as above for bge-m3).
CIVI_TAMIL_QUERY_THRESHOLD=0.52
CIVI_RETRIEVAL_CANDIDATES=30
CIVI_RETRIEVAL_TOP_K=5
# Allow document uploads from other devices on the private Wi-Fi (default: this laptop only).
CIVI_ADMIN_ALLOW_LAN=false

# ---------- Sarvam AI ----------
# Get a key at https://dashboard.sarvam.ai (new accounts get free credits). Never share or commit it.
# OPTIONAL for search: bge-m3 already handles Tamil questions. If set, Tamil questions are also
# translated to English before searching (costs about Rs 0.20 per question). Speech comes in Phase 4.
SARVAM_API_KEY=
CIVI_SARVAM_TRANSLATE_MODEL=mayura:v1
CIVI_SARVAM_TIMEOUT_SECONDS=15
